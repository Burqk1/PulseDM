{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse DM",
  "version": "0.3.0",
  "identifier": "com.novament.pulsedm",
  "build": {
    "beforeDevCommand": "node scripts/build-host.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-host.mjs && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Burqk1",
    "shortDescription": "Hızlı ve ücretsiz indirme yöneticisi",
    "resources": {
      "../extension/": "extension/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pulsedm-host"
    ],
    "copyright": "© 2026 Burqk1",
    "category": "Utility",
    "longDescription": "Pulse DM: çok bağlantılı, kaldığı yerden devam eden, ücretsiz indirme yöneticisi. YouTube ve video siteleri, tarayıcı eklentisi, kuyruk ve zamanlayıcı.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent file",
        "description": "BitTorrent file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQzcyNDc4QjRFMzM1OUUKUldTZU5lTzBlQ1RIT2lOd3pKMmd3V0pxdlFibDYwM0QxNkxzSmFEVDBIOWZzdzM4MXhJNGR5dmgK",
      "endpoints": [
        "https://github.com/Burqk1/PulseDM/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}
